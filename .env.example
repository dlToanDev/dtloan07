# ============================================================
# Copy sang .env rồi điền giá trị thật. KHÔNG commit file .env.
# Mọi biến ở đây đều được validate trong src/config/env.ts —
# thiếu biến bắt buộc thì app sẽ CRASH ngay khi khởi động.
# ============================================================

# --- App (P0) ---
NEXT_PUBLIC_SITE_URL="http://localhost:5000"

# --- Database (P5) ---
# Dùng Local PostgreSQL:
# DATABASE_URL="postgresql://blog_user:password@localhost:5432/blog_db?schema=public"
# DIRECT_URL="postgresql://blog_user:password@localhost:5432/blog_db?schema=public"
# Dùng Supabase:
# DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@[POOLER_HOST]:6543/postgres?pgbouncer=true&connection_limit=1&connect_timeout=30"
# DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@[POOLER_HOST]:5432/postgres?connect_timeout=30"
DATABASE_URL="postgresql://blog_user:password@localhost:5432/blog_db?schema=public"
DIRECT_URL="postgresql://blog_user:password@localhost:5432/blog_db?schema=public"

# --- Auth (P6) ---
# Sinh bằng: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:5000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- Email / Resend (P6) ---
RESEND_API_KEY=""
EMAIL_FROM="Blog <noreply@yourdomain.com>"
# Địa chỉ nhận email báo đơn mới (để trống = không gửi)
ADMIN_NOTIFY_EMAIL=""

# --- Object storage / Cloudflare R2 (P9) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Tùy chọn: endpoint S3 khác (vd. kho S3 local để test upload). Để trống = Cloudflare R2.
R2_ENDPOINT=""

# --- Tài khoản số (P3) ---
# Khóa mã hóa thông tin tài khoản, sinh bằng: openssl rand -base64 32
ACCOUNT_ENCRYPTION_KEY=""

# --- Payment / PayOS (P8) ---
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""

# --- Affiliate Shortener API (Rút gọn link kiếm tiền: MegaURL, Ouo.io, Shorte.st...) ---
# Ví dụ MegaURL: https://megaurl.in/api
SHORTENER_API_URL=""
SHORTENER_API_KEY=""

# --- Máy chấm code cho khóa học (Piston, xem deploy/piston/README.md) ---
PISTON_URL="http://127.0.0.1:2000"
